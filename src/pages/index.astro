---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
const partners = await getCollection('partners')
---

<Layout>
  <div class="overflow-x-hidden">
    <div class="bg-white p-8 md:p-16 md:text-center">
        <p class="mb-4 text-xl font-medium md:text-2xl">
    Milé a milí kandidující v letošních volbách do Zastupitelstva města Olomouce, vítáme Vás na webu, který si klade za cíl  pomoci olomouckým občankám a občanům vybrat si takové zástupce a zástupkyně, kteří nejen mají podobný pohled na to, jak by se naše město mělo v následujícím volebním období rozvíjet, ale jsou také ochotni se k podpoře konkrétních opatření veřejně zavázat.</p>
    </div>
    <div class="mt-8 bg-white/50 p-8 text-center backdrop-blur-sm">
      <h2 class="text-lg mb-4">Na projektu se podílí:</h2>
    <ul
        class="partners grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 md:gap-8"
      >
        {
          partners.map((partner) => (
            <li>
              <Image
                src={partner.data.logo}
                alt={partner.data.name}
                loading="eager"
                class="w-full h-20 object-contain aspect-3/2"
              />
            </li>
          ))
        }
      </ul>
      </div>
      </div>
</Layout>